# Jest-only infrastructure. Never point these at the development database/Redis DB 0.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/ai_cost_optimizer_test
TEST_REDIS_URL=redis://127.0.0.1:6379/1
JWT_SECRET=test-jwt-secret-that-is-at-least-thirty-two-characters-long
AGENT_KEY_HMAC_SECRET=test-agent-hmac-secret-that-is-at-least-thirty-two-characters-long
PROVIDER_KEY_ENCRYPTION_SECRET=test-provider-encryption-secret-at-least-thirty-two-characters
TOTP_ENCRYPTION_SECRET=test-totp-encryption-secret-that-is-at-least-thirty-two-characters
CACHE_CONTEXT_SIGNING_SECRET=test-cache-context-secret-that-is-at-least-thirty-two-characters
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
AGENT_RATE_LIMIT_PER_MINUTE=60
ORG_PROXY_RATE_LIMIT_PER_MINUTE=3000
PROXY_IP_EMERGENCY_LIMIT_PER_MINUTE=10000
GLOBAL_API_RATE_LIMIT_PER_MINUTE=100000
USER_READ_RATE_LIMIT_PER_MINUTE=600
USER_WRITE_RATE_LIMIT_PER_MINUTE=120
ORG_DASHBOARD_RATE_LIMIT_PER_MINUTE=3000
