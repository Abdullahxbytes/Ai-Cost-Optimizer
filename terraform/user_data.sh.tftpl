#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/costflow-setup.log) 2>&1

APP_DIR=/opt/costflow

apt-get update -y
apt-get install -y ca-certificates curl git docker.io docker-compose-plugin
systemctl enable --now docker

if [ -d "$APP_DIR/.git" ]; then
  git -C "$APP_DIR" fetch --depth=1 origin main
  git -C "$APP_DIR" reset --hard origin/main
else
  git clone --depth=1 --branch main "${github_repository}" "$APP_DIR"
fi

cd "$APP_DIR"
write_secret() {
  printf '%s=' "$1" >> .env
  printf '%s' "$2" | base64 -d >> .env
  printf '\n' >> .env
}

umask 077
rm -f .env
cat > .env <<'ENV'
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
PLATFORM_URL=http://localhost
TRUST_PROXY_HOPS=1
ENV
write_secret DATABASE_URL '${database_url_b64}'
write_secret REDIS_URL '${redis_url_b64}'
write_secret JWT_SECRET '${jwt_secret_b64}'
write_secret AGENT_KEY_HMAC_SECRET '${agent_key_hmac_secret_b64}'
write_secret PROVIDER_KEY_ENCRYPTION_SECRET '${provider_key_encryption_secret_b64}'
write_secret TOTP_ENCRYPTION_SECRET '${totp_encryption_secret_b64}'
write_secret CORS_ORIGINS '${cors_origins_b64}'
write_secret GEMINI_API_KEY '${gemini_api_key_b64}'

docker compose -f docker-compose.production.yml up -d --build
