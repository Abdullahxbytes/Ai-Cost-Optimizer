aws_region   = "us-east-1"
app_name     = "costflow"
environment  = "development"
db_username  = "optimizer"
db_password   = "REPLACE_WITH_A_GENERATED_DATABASE_PASSWORD"
key_pair_name = "cost-optimizer-key"
allowed_ssh_cidr = "119.160.114.206/32"

# Generate each with: openssl rand -base64 48
jwt_secret                       = "REPLACE_WITH_A_GENERATED_JWT_SECRET"
agent_key_hmac_secret            = "REPLACE_WITH_A_GENERATED_HMAC_SECRET"
provider_key_encryption_secret   = "REPLACE_WITH_A_GENERATED_PROVIDER_KEY_SECRET"
totp_encryption_secret           = "REPLACE_WITH_A_DIFFERENT_GENERATED_SECRET"
cors_origins                     = "http://YOUR_EC2_PUBLIC_IP"

# Optional: used only for server-side Gemini embeddings / semantic cache.
gemini_api_key = ""
