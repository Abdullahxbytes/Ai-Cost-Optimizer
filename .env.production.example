# Copy to .env.production, fill in the actual values, and keep it private.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
PLATFORM_URL=http://YOUR_EC2_PUBLIC_IP

# Private AWS service endpoints. Do not use localhost in production.
DATABASE_URL=postgresql://optimizer:REPLACE_DATABASE_PASSWORD@YOUR_RDS_ENDPOINT:5432/cost_optimizer
REDIS_URL=redis://YOUR_REDIS_ENDPOINT:6379

# Generate unique 32+ character secrets. Never reuse the example values.
JWT_SECRET=REPLACE_WITH_A_GENERATED_JWT_SECRET
JWT_EXPIRES_IN=7d
AGENT_KEY_HMAC_SECRET=REPLACE_WITH_A_GENERATED_HMAC_SECRET
PROVIDER_KEY_ENCRYPTION_SECRET=REPLACE_WITH_A_GENERATED_ENCRYPTION_SECRET
TOTP_ENCRYPTION_SECRET=REPLACE_WITH_A_DIFFERENT_GENERATED_ENCRYPTION_SECRET
# Required for per-end-user cache scopes; use a separate high-entropy value.
CACHE_CONTEXT_SIGNING_SECRET=REPLACE_WITH_A_THIRD_GENERATED_SIGNING_SECRET

# Public browser origin(s), comma-separated. One nginx hop fronts the API in the supplied deployment.
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP
TRUST_PROXY_HOPS=1
AGENT_RATE_LIMIT_PER_MINUTE=60
ORG_PROXY_RATE_LIMIT_PER_MINUTE=3000
PROXY_IP_EMERGENCY_LIMIT_PER_MINUTE=10000
GLOBAL_API_RATE_LIMIT_PER_MINUTE=100000
USER_READ_RATE_LIMIT_PER_MINUTE=600
USER_WRITE_RATE_LIMIT_PER_MINUTE=120
ORG_DASHBOARD_RATE_LIMIT_PER_MINUTE=3000

# Optional services. Populate only when CostFlow needs them.
GROQ_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
