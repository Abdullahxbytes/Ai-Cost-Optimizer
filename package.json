{
  "name": "ai-cost-optimizer",
  "version": "0.1.0",
  "description": "Multi-tenant platform for monitoring, controlling, and optimizing LLM API costs",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -- tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "bootstrap:superadmin": "tsx scripts/bootstrapSuperAdmin.ts",
    "add:superadmin": "tsx scripts/addSuperAdmin.ts",
    "migrate:agent-keys": "tsx scripts/migrateAgentKeyHashes.ts",
    "verify:last-superadmin-guard": "tsx scripts/verifyLastSuperAdminGuard.ts",
    "scan:alerts": "tsx scripts/runAlertScan.ts",
    "cleanup:team-archives": "tsx scripts/runTeamArchiveCleanup.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.1.11",
    "date-fns": "^2.30.0",
    "dictionary-en": "^4.0.0",
    "dotenv": "^16.3.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "jose": "^5.1.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.5",
    "nspell": "^2.1.5",
    "otplib": "^13.4.1",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "postgres": "^3.4.3",
    "qrcode": "^1.5.4",
    "redis": "^5.0.0",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv-cli": "^7.3.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "llm",
    "cost-optimization",
    "budget-management",
    "api-monitoring",
    "semantic-cache"
  ],
  "author": "",
  "license": "MIT"
}
