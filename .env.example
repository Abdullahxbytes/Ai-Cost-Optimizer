# Database
DATABASE_URL=postgres://user:password@localhost:5432/ai_cost_optimizer

# Redis
REDIS_URL=redis://localhost:6379

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Auth
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
# Separate high-entropy key used to one-way HMAC agent credentials before storage.
AGENT_KEY_HMAC_SECRET=generate-a-64-character-random-secret

# LLM Providers (add as needed)
PROVIDER_KEY_ENCRYPTION_SECRET=generate-a-64-character-random-secret
TOTP_ENCRYPTION_SECRET=generate-a-different-64-character-random-secret
# Required only for signed, per-end-user cache context tokens.
CACHE_CONTEXT_SIGNING_SECRET=generate-a-third-independent-64-character-random-secret

# Browser and reverse-proxy boundary
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
AGENT_RATE_LIMIT_PER_MINUTE=60
ORG_PROXY_RATE_LIMIT_PER_MINUTE=3000
PROXY_IP_EMERGENCY_LIMIT_PER_MINUTE=10000
GLOBAL_API_RATE_LIMIT_PER_MINUTE=100000
USER_READ_RATE_LIMIT_PER_MINUTE=600
USER_WRITE_RATE_LIMIT_PER_MINUTE=120
ORG_DASHBOARD_RATE_LIMIT_PER_MINUTE=3000
GROQ_API_KEY=gsk-xxx

# Embeddings (for semantic cache)
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=gemini-embedding-001

# Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=app-password

# Platform
PLATFORM_URL=http://localhost:3000
